{
  "name": "irnr",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "dev:test": "IRNR_DATA_DIR=./data-test IRNR_TODAY=2026-10-10 next dev --turbopack -p 3100",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "npm run db:reset:test && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:example": "rm -rf .example-tmp data/irnr.db.example && IRNR_DATA_DIR=./.example-tmp tsx scripts/migrate.ts && IRNR_DATA_DIR=./.example-tmp tsx scripts/seed.ts --demo && sqlite3 .example-tmp/irnr.db \"VACUUM INTO 'data/irnr.db.example'\" && rm -rf .example-tmp",
    "db:reset:test": "rm -rf data-test && IRNR_DATA_DIR=./data-test tsx scripts/migrate.ts && IRNR_DATA_DIR=./data-test tsx scripts/seed.ts --demo",
    "seed": "tsx scripts/seed.ts",
    "import": "tsx scripts/import-sheet.ts",
    "import:comunidad": "tsx scripts/import-comunidad.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
